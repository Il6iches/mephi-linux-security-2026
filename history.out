groupadd students
useradd -u 1234 -g students -m user1
passwd user1
chage -M 90 user1
find / -perm -4000 -type f 2>/dev/null
ps -eo pid,ruid,euid,comm | awk '$3 == 0 && $2 >= 1000'
cp /usr/bin/cat /home/user1/my_cat
chown root:root /home/user1/my_cat
chmod 4755 /home/user1/my_cat
cp /usr/bin/chown /home/user1/my_chown
chown user1:students /home/user1/my_chown
chmod 755 /home/user1/my_chown
setcap cap_chown+ep /home/user1/my_chown
visudo /etc/sudoers.d/user1_time
echo 372997
history -a
passwd
cat /etc/shadow
/home/user1/my_cat /etc/shadow
touch /home/user1/testfile
/home/user1/my_chown root /home/user1/testfile
ls -l /home/user1/testfile
sudo date -s "17:00:00"
history -a
